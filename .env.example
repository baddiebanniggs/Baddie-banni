# Copy to .env and fill in. NEVER commit the real .env file.
# Database (PostgreSQL). Docker compose uses its own default; replace for production.
DATABASE_URL="postgresql://baddie:CHANGE_ME@localhost:5432/baddie_banni"
# Public address of the site (no trailing slash). Not live yet.
SITE_URL="http://localhost:3000"
# Long random string (32+ chars) used to sign sessions. Part 2 uses this.
AUTH_SECRET="CHANGE_ME_LONG_RANDOM_STRING"
# Payment gateway: none | razorpay | cashfree | phonepe. Chosen later; keep 'none' until credentials exist.
PAYMENT_PROVIDER="none"
PAYMENT_KEY_ID=""
PAYMENT_KEY_SECRET=""
PAYMENT_WEBHOOK_SECRET=""
# Transactional email (provider chosen in Part 3).
EMAIL_PROVIDER="none"
EMAIL_API_KEY=""
EMAIL_FROM="orders@example.invalid"
# Optional Google sign-in (leave blank to disable).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
